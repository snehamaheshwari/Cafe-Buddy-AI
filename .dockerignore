# Git
.git
.gitignore

# Node — Docker installs fresh in Stage 1
frontend/node_modules/

# Pre-built dist — Docker rebuilds from source in Stage 1
frontend/dist/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Local environment & secrets
.env
.env.local
*.env

# Tunnel & log artefacts
*.log
cloudflared.exe
serveo_*.log

# Docs / meta
README.md
render.yaml

# Local tunnel / ngrok
ngrok.exe
scripts/tunnel.bat

# Uploaded data (cloud uses persistent volume)
backend/data/

# Large auto-generated model files (not needed in cloud)
backend/models/random_forest.pkl
backend/models/xgboost.pkl
backend/models/lstm.keras
